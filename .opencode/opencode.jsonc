{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "brainstorm",
  "agent": {
    "session-maintainer": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "temperature": 0.3,
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow",
        "task": "allow"
      }
    },
    "brainstorm": {
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.8,
      "mode": "all",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "allow"
      }
    },
    "branch-diff-analyzer": {
      "model": "opencode/muse-spark-1.2-contributor-free",
      "temperature": 0.1,
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "brutal-critique-panel": {
      "model": "opencode/nemotron-3-ultra-free",
      "temperature": 0.0,
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "embedded-serial-agent": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "integration-ops-agent": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "ros-control-agent": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "ui-frontend-agent": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    }
  }
}
